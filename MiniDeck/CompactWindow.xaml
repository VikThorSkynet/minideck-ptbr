<Window x:Class="MiniDeck.CompactWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MiniDeck · Painel compacto" Width="420" Height="345" MinWidth="320" MinHeight="315" MaxWidth="900" MaxHeight="800" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowActivated="False" Background="#111A27" Foreground="#EAF0F7" FontFamily="Segoe UI" FontSize="12" WindowStartupLocation="Manual">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="Background" Value="#213046"/><Setter Property="BorderBrush" Value="#34455E"/><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#68DFC3"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#68DFC3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="OuterEdge" BorderBrush="#3E596A" BorderThickness="1" CornerRadius="10" Padding="10">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="HeaderDrag" ToolTip="Arraste este cabeçalho para mover o painel para outra tela.">
    <DockPanel><Button Content="×" DockPanel.Dock="Right" Click="HideClick" ToolTip="Ocultar painel; o MiniDeck continua na bandeja."/><Button Content="Configurar" DockPanel.Dock="Right" Click="ConfigureClick"/><Button x:Name="StopButton" Content="■" Visibility="Collapsed" DockPanel.Dock="Right" Click="StopClick" ToolTip="Parar a sequência em execução."/><CheckBox x:Name="PinBox" Content="Fixar" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#B7C9D8" Margin="5,0,8,0" ToolTip="Manter o painel por cima de outras janelas." Checked="PinChanged" Unchecked="PinChanged"/><TextBlock Text="MINIDECK" Foreground="#91A7BC" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   </Border>
   <Grid Grid.Row="1" Margin="3,6,3,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CAMADA ATUAL" Foreground="#93A3B8" FontSize="9"/><TextBlock x:Name="LayerText" FontSize="20" FontWeight="SemiBold" Foreground="#68DFC3" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="ModeText" Text="Verificando…" HorizontalAlignment="Right" Foreground="#68DFC3" FontSize="10"/><ComboBox x:Name="LayerPicker" DisplayMemberPath="Name" SelectedValuePath="Id" MinWidth="110" MaxWidth="180" FontSize="11" Margin="0,4,0,0" SelectionChanged="LayerSelected" ToolTip="Escolher a camada em uso."/></StackPanel></Grid>
   <UniformGrid Grid.Row="2" x:Name="CompactKeys" Columns="3"/>
   <StackPanel Grid.Row="3" x:Name="CompactKnobs" Margin="0,5,0,0"/>
   <DockPanel Grid.Row="4" Margin="3,7,4,0"><Button x:Name="SoundStopButton" DockPanel.Dock="Right" Content="♪ ■" FontSize="10" Padding="4,0" Margin="4,0,0,0" Visibility="Collapsed" Click="SoundStopClick" ToolTip="Parar todos os sons."/><TextBlock x:Name="LastKeyText" DockPanel.Dock="Left" MaxWidth="125" Margin="0,0,8,0" Foreground="#FFD166" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/><TextBlock x:Name="LastText" Text="Aguardando tecla…" Foreground="#A7BACB" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="O resultado da última ação aparece aqui."/></DockPanel>
  </Grid>
 </Border>
</Window>
