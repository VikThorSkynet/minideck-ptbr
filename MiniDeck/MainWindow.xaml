<Window x:Class="MiniDeck.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MiniDeck" Title="MiniDeck · Seu teclado, do seu jeito" Width="1300" Height="880" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#0D121B" Foreground="#EAF0F7" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Tema.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- MENU LATERAL -->
  <Border Background="{StaticResource Lateral}" BorderBrush="#222E40" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,24,14,18">
    <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
     <StackPanel Orientation="Horizontal"><Border Background="#68DFC3" CornerRadius="8" Width="34" Height="34"><TextBlock Text="◧" FontSize="19" Foreground="#102720" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="MiniDeck" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
     <TextBlock Text="SEU TECLADO. SUAS REGRAS." FontSize="9" FontWeight="SemiBold" Foreground="#68DFC3" Margin="2,10,0,0"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom">
     <Border Background="#151F2E" BorderBrush="#2A394E" BorderThickness="1" CornerRadius="12" Padding="12,10,12,4" Margin="0,0,0,10" ToolTip="Volume geral dos sons que o MiniDeck toca (ações Sons · tocar arquivo). Não altera o volume do Windows nem de outros programas.">
      <StackPanel>
       <DockPanel><TextBlock Text="♪" Foreground="#FFD166" Margin="0,0,6,0"/><TextBlock x:Name="SoundMasterLabel" Text="Sons · volume geral: 100%" FontSize="11.5" Foreground="#FFD166" FontWeight="SemiBold"/></DockPanel>
       <Slider x:Name="SoundMasterSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,8" ValueChanged="SoundMasterChanged" ToolTip="Arraste para ajustar o volume de todos os sons do MiniDeck de uma vez (0 a 100%)."/>
       <Button x:Name="StopSoundsButton" Content="■  Parar todos os sons" Click="StopSoundsClick" Style="{StaticResource Small}" HorizontalContentAlignment="Center" Margin="0,0,0,8" ToolTip="Interrompe na hora todos os sons que o MiniDeck está tocando, inclusive os que estão em repetição."/>
      </StackPanel>
     </Border>
     <Button Content="■  Parar sequência" x:Name="StopSequenceButton" Click="StopSequenceClick" Visibility="Collapsed" Style="{StaticResource Danger}" HorizontalContentAlignment="Center" Margin="0,0,0,8" ToolTip="Interrompe a sequência de ações (macro) que está rodando agora."/>
     <Button Name="CompactModeButton" Click="CompactClick" Style="{StaticResource Primary}" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" ToolTip="Troca esta janela por um painel pequeno que mostra a camada em uso e o que cada tecla faz. Ideal para deixar numa segunda tela.">
      <StackPanel><TextBlock Text="▣  Modo compacto" FontWeight="SemiBold"/><TextBlock Text="Painel pequeno para a 2ª tela" FontSize="10.5" FontWeight="Normal" Opacity="0.8" Margin="0,2,0,0"/></StackPanel>
     </Button>
     <Button Click="MinimizeClick" Style="{StaticResource Small}" Margin="0,0,0,12" HorizontalContentAlignment="Stretch" ToolTip="Salva tudo e esconde a janela. O MiniDeck continua funcionando: abra de novo pelo ícone perto do relógio do Windows.">
      <StackPanel><TextBlock Text="⤓  Salvar e minimizar"/><TextBlock Text="Continua ativo na bandeja" FontSize="10.5" Foreground="#93A3B8" Margin="0,2,0,0"/></StackPanel>
     </Button>
     <TextBlock Text="Português · Brasil" Foreground="#93A3B8" FontSize="11" Margin="4,0,0,0"/>
     <TextBlock Text="Perfis salvos só neste computador" Foreground="#6F8198" FontSize="11" Margin="4,2,0,0"/>
    </StackPanel>

    <ScrollViewer Margin="0,0,0,10"><StackPanel>
     <TextBlock Text="MENU" Style="{StaticResource SectionLabel}" FontSize="10" Margin="8,0,0,8"/>
     <Button x:Name="NavDeck" Click="DeckClick" Style="{StaticResource Nav}" ToolTip="Tela principal: escolha o que cada tecla e o knob fazem em cada camada.">
      <StackPanel><TextBlock Text="▦   Seu teclado" FontWeight="SemiBold"/><TextBlock Text="Camadas e ações de cada tecla" FontSize="11" Foreground="#93A3B8" Margin="24,2,0,0"/></StackPanel>
     </Button>
     <Button x:Name="NavLed" Click="LedClick" Style="{StaticResource Nav}" ToolTip="Envia um dos modos de iluminação (LED) para a memória do teclado.">
      <StackPanel><TextBlock Text="☀   Iluminação" FontWeight="SemiBold"/><TextBlock Text="Modos de LED do teclado" FontSize="11" Foreground="#93A3B8" Margin="24,2,0,0"/></StackPanel>
     </Button>
     <Button x:Name="NavHardware" Click="HardwareClick" Style="{StaticResource Nav}" ToolTip="Grava um comando direto na memória do teclado. Ele funciona mesmo com o MiniDeck fechado ou em outro computador.">
      <StackPanel><TextBlock Text="⇣   Gravar no teclado" FontWeight="SemiBold"/><TextBlock Text="Funciona até sem o MiniDeck" FontSize="11" Foreground="#93A3B8" Margin="24,2,0,0"/></StackPanel>
     </Button>
     <Button x:Name="NavHelp" Click="HelpClick" Style="{StaticResource Nav}" ToolTip="Guia completo: primeiros passos, glossário, sons, OBS, macros e solução de problemas.">
      <StackPanel><TextBlock Text="?    Como funciona" FontWeight="SemiBold"/><TextBlock Text="Guia, glossário e problemas" FontSize="11" Foreground="#93A3B8" Margin="24,2,0,0"/></StackPanel>
     </Button>
     <Border Background="#14262C" BorderBrush="#244A4A" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,14,0,0" ToolTip="Camadas multiplicam suas teclas: a mesma tecla pode copiar numa camada e tocar um som em outra.">
      <StackPanel>
       <TextBlock Text="💡 Dica" Foreground="#68DFC3" FontWeight="SemiBold"/>
       <TextBlock Text="Passe o mouse sobre qualquer botão ou campo para ver o que ele faz." Style="{StaticResource Caption}" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel></ScrollViewer>
   </DockPanel>
  </Border>

  <!-- ÁREA PRINCIPAL -->
  <Grid Grid.Column="1" Margin="28,22,28,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,14">
    <Border DockPanel.Dock="Right" Background="#151F2E" BorderBrush="#2A394E" BorderThickness="1" CornerRadius="12" Padding="14,9" VerticalAlignment="Top" ToolTip="Mostra se o mini teclado USB está conectado e qual camada está em uso agora. A camada em uso define o que cada tecla faz.">
     <StackPanel MinWidth="190"><TextBlock x:Name="ConnectionText" Text="Verificando conexão…" Foreground="#68DFC3" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="ActiveText" Text="Em uso: Principal" Foreground="#93A3B8" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel>
    </Border>
    <StackPanel><TextBlock x:Name="PageTitle" Text="Seu teclado, do seu jeito" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Escolha uma camada, clique em uma tecla e defina sua ação." Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,0"/></StackPanel>
   </DockPanel>

   <Border Grid.Row="1" Background="#14262C" BorderBrush="#244A4A" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
    <DockPanel>
     <Button x:Name="BridgeButton" DockPanel.Dock="Right" Content="Ativar camadas" Style="{StaticResource Primary}" Click="BridgeClick" Padding="16,9" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="Ativar camadas: prepara o teclado (só na primeira vez) e liga as ações do MiniDeck.&#10;Pausar ações: as teclas param de executar as ações do MiniDeck até você retomar; nada é apagado.&#10;Retomar ações: volta a executar as ações."/>
     <TextBlock Text="⚡" FontSize="20" Foreground="#68DFC3" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="BridgeTitle" Text="Prepare o teclado uma única vez" FontWeight="SemiBold" Foreground="#9CE9D6"/><TextBlock x:Name="BridgeText" Text="O MiniDeck precisa ficar aberto para executar camadas e controles de áudio." FontSize="12" Foreground="#AEC0CF" Margin="0,4,0,0"/></StackPanel>
    </DockPanel>
   </Border>

   <Grid Grid.Row="2">
    <!-- SEU TECLADO -->
    <Grid x:Name="DeckView">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="372"/></Grid.ColumnDefinitions>
     <ScrollViewer><StackPanel Margin="0,0,8,0">
      <UniformGrid Columns="3" Margin="0,0,0,16">
       <Border Style="{StaticResource InfoBox}" Margin="0,0,6,0" Padding="11,9"><DockPanel><Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Escolha a camada" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Cada camada é um jogo de funções." Foreground="#93A3B8" FontSize="11"/></StackPanel></DockPanel></Border>
       <Border Style="{StaticResource InfoBox}" Margin="3,0,3,0" Padding="11,9"><DockPanel><Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Clique numa tecla" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="Ou numa ação do knob." Foreground="#93A3B8" FontSize="11"/></StackPanel></DockPanel></Border>
       <Border Style="{StaticResource InfoBox}" Margin="6,0,0,0" Padding="11,9"><DockPanel><Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Configure e salve" FontWeight="SemiBold" FontSize="12.5"/><TextBlock Text="No painel à direita → Salvar ação." Foreground="#93A3B8" FontSize="11"/></StackPanel></DockPanel></Border>
      </UniformGrid>

      <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
       <StackPanel>
        <DockPanel>
         <Button Content="+ Nova" Click="AddLayerClick" DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Cria uma camada vazia. A última tecla dela já vem configurada para trocar de camada, para você nunca ficar preso."/>
         <Button Content="♪ + Sons" Name="AddSoundsLayerButton" Click="AddSoundsLayerClick" DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="Cria uma camada pronta para sons (soundboard): teclas livres para seus MP3/WAV e o knob controlando o volume dos sons."/>
         <StackPanel><TextBlock Text="SUAS CAMADAS" Style="{StaticResource SectionLabel}"/><TextBlock Text="Clique numa camada para usá-la e editá-la. A tecla de troca (no perfil inicial, a última) alterna entre elas." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
        </DockPanel>
        <WrapPanel x:Name="LayerPanel" Margin="0,10,0,4"/>
        <WrapPanel Margin="0,4,0,-8">
         <Button Content="✎ Renomear" Click="RenameLayerClick" Style="{StaticResource Small}" ToolTip="Muda o nome da camada selecionada. As ações dela continuam iguais."/>
         <Button Content="⧉ Duplicar" Click="DuplicateLayerClick" Style="{StaticResource Small}" ToolTip="Cria uma cópia da camada selecionada, com todas as ações. Bom ponto de partida para uma variação."/>
         <Button Content="🎨 Cor do painel" Click="LayerColorClick" Style="{StaticResource Small}" ToolTip="Escolhe a cor que identifica esta camada na tela (no painel compacto). Não altera o LED do teclado."/>
         <Button Content="🗑 Excluir camada" Click="DeleteLayerClick" Style="{StaticResource Danger}" ToolTip="Apaga a camada selecionada e todas as ações dela. O MiniDeck pede confirmação antes."/>
        </WrapPanel>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" CornerRadius="16" Padding="19">
       <StackPanel>
        <DockPanel Margin="0,0,0,14"><TextBlock x:Name="LayoutCaption" Text="6 teclas · 1 knob" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="#93A3B8" ToolTip="Quantidade de teclas e knobs do desenho. Para mudar, abra “Ajustar layout e gerenciar perfil” logo abaixo."/><TextBlock Text="MINI KEYBOARD" Style="{StaticResource SectionLabel}"/></DockPanel>
        <UniformGrid x:Name="KeyGrid" Columns="3"/>
        <StackPanel x:Name="KnobPanel" Margin="0,12,0,0"/>
        <Border Style="{StaticResource InfoBox}" Margin="0,12,0,0" Padding="12,9"><TextBlock Text="Clique num cartão para configurá-lo no painel à direita. Quando você aperta a tecla física, o cartão correspondente acende aqui, assim você sabe qual é qual. O knob tem três ações: girar para a esquerda, apertar e girar para a direita." Foreground="#AABACE" FontSize="12" LineHeight="18"/></Border>
       </StackPanel>
      </Border>

      <Expander Header="⚙  Ajustar layout e gerenciar perfil (backup)" Margin="0,18,0,8" ToolTip="Mude a quantidade de teclas e knobs do desenho, ou faça backup / restaure todas as suas camadas.">
       <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="18">
        <StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="Teclas físicas" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="KeyCountBox" SelectionChanged="LayoutChanged" ToolTip="Quantas teclas o seu mini teclado tem. Mudar isso pausa as camadas até você ativá-las de novo."/><TextBlock Text="Quantas teclas o seu modelo tem." Style="{StaticResource Caption}"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Botões giratórios (knobs)" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="KnobCountBox" SelectionChanged="LayoutChanged" ToolTip="Quantos knobs o seu mini teclado tem. Cada knob tem 3 ações: esquerda, apertar e direita."/><TextBlock Text="Cada knob conta como 3 entradas." Style="{StaticResource Caption}"/></StackPanel>
         </Grid>
         <Border Style="{StaticResource WarnBox}" Margin="0,0,0,12"><TextBlock Text="Ao mudar o layout, as camadas são pausadas. Depois clique em “Ativar camadas” para preparar o teclado de novo." Foreground="#E9D9A8" FontSize="12"/></Border>
         <WrapPanel>
          <Button Content="⇪ Exportar perfil" Click="ExportClick" Style="{StaticResource Small}" ToolTip="Salva todas as camadas e ações num arquivo .json. Use como backup ou para levar a outro computador."/>
          <Button Content="⇩ Importar perfil" Click="ImportClick" Style="{StaticResource Small}" ToolTip="Carrega um arquivo .json exportado antes. Substitui o perfil aberto (o atual fica guardado em perfil.json.bak)."/>
         </WrapPanel>
         <TextBlock Text="O perfil inclui todas as camadas e caminhos dos sons (não os arquivos de áudio). Exportar não lê a memória do teclado." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
        </StackPanel>
       </Border>
      </Expander>
     </StackPanel></ScrollViewer>

     <!-- PAINEL DE CONFIGURAÇÃO -->
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18"><ScrollViewer><StackPanel Margin="0,0,6,0">
      <TextBlock Text="CONFIGURAR AÇÃO" Foreground="#68DFC3" FontSize="10.5" FontWeight="Bold"/>
      <TextBlock x:Name="EditorTitle" Text="Tecla 1" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBlock x:Name="EditorLayer" Style="{StaticResource Caption}" ToolTip="Camada em edição e o atalho que esta entrada envia quando estiver como “Sem ação”."/>
      <Border Style="{StaticResource InfoBox}" Margin="0,0,0,14" Padding="12,10">
       <StackPanel>
        <CheckBox x:Name="LayerHotkeysBox" Content="Atalhos exclusivos por camada" Foreground="#68DFC3" FontWeight="SemiBold" Checked="LayerHotkeysChanged" Unchecked="LayerHotkeysChanged" ToolTip="Ligado (recomendado): cada tecla “Sem ação” envia uma combinação diferente em cada camada (ex.: F17, depois Ctrl+F17), para você cadastrar no OBS, Discord ou outro programa. Os F13–F24 físicos ficam reservados para o MiniDeck.&#10;Desligado: modo compartilhado antigo, em que os F13–F24 também chegam aos outros programas."/>
        <TextBlock Text="Ligado: tecla “Sem ação” = atalho único da camada, para usar em outros programas (OBS, Discord…)." Foreground="#93A3B8" FontSize="11.5" Margin="22,4,0,0"/>
       </StackPanel>
      </Border>
      <local:ActionEditor x:Name="Editor"/>
      <Button Content="✓  Salvar ação" Style="{StaticResource Primary}" Click="SaveActionClick" HorizontalContentAlignment="Center" Margin="0,8,0,8" ToolTip="Guarda esta configuração. A partir daí, apertar a tecla física executa esta ação."/>
      <Button Content="▶  Testar ação em 3 segundos" Click="TestActionClick" HorizontalContentAlignment="Center" Margin="0,0,0,8" ToolTip="Executa o que está no formulário daqui a 3 segundos, sem salvar. Use esse tempo para clicar no programa onde a ação deve acontecer."/>
      <TextBlock Text="Salve antes de trocar de tecla, senão a alteração se perde. No teste, você tem 3 segundos para clicar no aplicativo de destino." Style="{StaticResource Caption}" FontSize="11.5"/>
     </StackPanel></ScrollViewer></Border>
    </Grid>

    <!-- ILUMINAÇÃO -->
    <ScrollViewer x:Name="LedView" Visibility="Collapsed"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="Os três modos disponíveis neste protocolo" FontSize="21" FontWeight="SemiBold"/>
       <TextBlock Text="O protocolo do teclado oferece os modos 0, 1 e 2. O programa original não diz o que cada um faz: a única forma de saber é enviar e olhar o teclado. A presença de LEDs e o efeito de cada modo dependem da versão do seu aparelho." Style="{StaticResource Caption}" FontSize="13" Margin="0,10,0,18"/>
       <DockPanel Margin="0,0,0,4"><Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Camada na memória do teclado" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/></DockPanel>
       <ComboBox x:Name="LedLayer" ToolTip="O teclado guarda até 3 configurações internas (camadas de memória). Normalmente use a Camada 1."/>
       <TextBlock Text="Normalmente a Camada 1. Algumas versões só aceitam essa." Style="{StaticResource Caption}"/>
       <DockPanel Margin="0,0,0,4"><Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Modo de iluminação" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/></DockPanel>
       <ComboBox x:Name="LedMode" ToolTip="Escolha 0, 1 ou 2 e envie. Observe o teclado para ver o efeito; se não gostar, envie outro modo."/>
       <TextBlock x:Name="LastLedMode" Style="{StaticResource Caption}"/>
       <DockPanel Margin="0,0,0,8"><Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Envie e observe o teclado" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/></DockPanel>
       <Button x:Name="ApplyLedButton" Content="☀  Gravar modo de LED" Click="ApplyLedClick" Style="{StaticResource Primary}" HorizontalAlignment="Left" ToolTip="Envia o modo escolhido para a memória do teclado. O MiniDeck pede confirmação antes."/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource WarnBox}" Margin="0,14,0,0"><TextBlock Text="O programa original não tem comandos para cor RGB, brilho, velocidade ou luz por tecla, por isso esses ajustes não aparecem aqui. Alterar o LED grava a configuração de iluminação na memória do teclado. Trocar de camada no MiniDeck não muda o LED." Foreground="#E9D9A8" FontSize="12.5" LineHeight="19"/></Border>
    </StackPanel></ScrollViewer>

    <!-- GRAVAR NO TECLADO -->
    <ScrollViewer x:Name="HardwareView" Visibility="Collapsed"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="Uma ação que funciona sem o MiniDeck aberto" FontSize="21" FontWeight="SemiBold"/>
       <TextBlock Text="Grava um atalho (até 5 teclas em sequência), um comando de mídia ou de mouse direto na memória do teclado. Ele passa a funcionar em qualquer computador, mesmo com o MiniDeck fechado. Já volume por aplicativo, microfone, sons e camadas do MiniDeck precisam do aplicativo aberto em segundo plano." Style="{StaticResource Caption}" FontSize="13" Margin="0,10,0,18"/>
       <DockPanel Margin="0,0,0,4"><Border Style="{StaticResource StepBadge}"><TextBlock Text="1" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Entrada física" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/></DockPanel>
       <ComboBox x:Name="HardwareSlot" ToolTip="Qual tecla ou ação do knob vai receber o comando."/>
       <TextBlock Text="A tecla ou ação do knob que vai receber o comando." Style="{StaticResource Caption}"/>
       <DockPanel Margin="0,0,0,4"><Border Style="{StaticResource StepBadge}"><TextBlock Text="2" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Camada na memória do teclado" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/></DockPanel>
       <ComboBox x:Name="HardwareLayer" ToolTip="Camada interna do teclado (1 a 3). Não é a mesma coisa que as camadas do MiniDeck. Normalmente use a Camada 1."/>
       <TextBlock Text="Camada interna do aparelho (não é camada do MiniDeck). Normalmente a 1." Style="{StaticResource Caption}"/>
       <DockPanel Margin="0,0,0,4"><Border Style="{StaticResource StepBadge}"><TextBlock Text="3" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Tipo de comando" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/></DockPanel>
       <ComboBox x:Name="HardwareKind" SelectionChanged="HardwareKindChanged" ToolTip="Atalho / sequência: teclas do teclado. Multimídia: tocar/pausar, volume etc. Mouse: cliques e rolagem."/>
       <TextBlock Text="Atalho de teclado, multimídia ou mouse." Style="{StaticResource Caption}"/>
       <DockPanel Margin="0,0,0,4"><Border Style="{StaticResource StepBadge}"><TextBlock Text="4" Foreground="#68DFC3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="O comando" Style="{StaticResource FieldLabel}" Margin="0,2,0,0"/></DockPanel>
       <StackPanel x:Name="HardwareTextPanel"><TextBlock Text="Atalho ou sequência (separe os passos com ponto e vírgula)" Foreground="#AABACE" FontSize="12.5"/><TextBox x:Name="HardwareValue" Text="Ctrl+C" ToolTip="Digite a combinação, por exemplo Ctrl+C. Para uma sequência, separe com ; (até 5 passos), por exemplo Ctrl+A; Ctrl+C. A lista de nomes aceitos está em Como funciona."/><TextBlock Text="Exemplos: Ctrl+C  ·  Ctrl+A; Ctrl+C  ·  Alt+Tab  ·  F5. O layout PT-BR é definido no Windows." Style="{StaticResource Caption}"/></StackPanel>
       <StackPanel x:Name="HardwareChoicePanel" Visibility="Collapsed"><TextBlock Text="Comando" Foreground="#AABACE" FontSize="12.5"/><ComboBox x:Name="HardwareChoice" ToolTip="Escolha o comando de mídia ou de mouse que a entrada vai executar."/><TextBlock Text="Escolha o comando na lista." Style="{StaticResource Caption}"/></StackPanel>
       <Button x:Name="ApplyHardwareButton" Content="⇣  Revisar e gravar esta entrada" Click="ApplyHardwareClick" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="Mostra um resumo e pede confirmação antes de gravar na memória do teclado."/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource WarnBox}" Margin="0,14,0,0"><TextBlock Text="⚠ A gravação substitui o comando que essa entrada tinha. O teclado não permite ler a configuração anterior, então não há como recuperá-la depois. As camadas do MiniDeck são pausadas para evitar que o painel mostre ações diferentes do que o teclado faz." Foreground="#E9D9A8" FontSize="12.5" LineHeight="19"/></Border>
    </StackPanel></ScrollViewer>

    <!-- COMO FUNCIONA -->
