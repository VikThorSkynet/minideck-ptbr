<Window x:Class="MiniDeck.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MiniDeck" Title="MiniDeck · Seu teclado, do seu jeito" Width="1260" Height="850" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#0D121B" Foreground="#EAF0F7" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#93A3B8"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="Background" Value="#202C3D"/><Setter Property="BorderBrush" Value="#33445B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#63D8BF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.42"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#63D8BF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#68DFC3"/><Setter Property="Foreground" Value="#102720"/><Setter Property="BorderBrush" Value="#68DFC3"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1623"/><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="BorderBrush" Value="#3A4A61"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,5,0,15"/><Setter Property="CaretBrush" Value="#68DFC3"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#F0F3F8"/><Setter Property="Foreground" Value="#142033"/><Setter Property="Padding" Value="8,9"/><Setter Property="Margin" Value="0,5,0,15"/><Setter Property="MinHeight" Value="38"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#93A3B8"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111A27" BorderBrush="#263246" BorderThickness="0,0,1,0">
   <DockPanel Margin="20,26,16,22">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,26"><TextBlock Text="◧  MiniDeck" FontSize="25" FontWeight="Bold"/><TextBlock Text="SEU TECLADO. SUAS REGRAS." FontSize="9" Foreground="#68DFC3" Margin="2,8,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="SoundMasterLabel" Text="Sons · volume geral: 100%" FontSize="11" Foreground="#FFD166"/><Slider x:Name="SoundMasterSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,8,12" ValueChanged="SoundMasterChanged" ToolTip="Volume somente dos sons do MiniDeck."/><Button x:Name="StopSoundsButton" Content="■  Parar sons" Click="StopSoundsClick" FontSize="12" Padding="10,6"/><Button Content="Parar sequência" x:Name="StopSequenceButton" Click="StopSequenceClick" Visibility="Collapsed"/><Button Content="▣  Modo compacto" Name="CompactModeButton" Click="CompactClick" Style="{StaticResource Primary}" Margin="0,0,0,12"/><TextBlock Text="Português · Brasil" Foreground="#93A3B8" FontSize="12"/><TextBlock Text="Perfis salvos neste computador" Style="{StaticResource Caption}"/><Button Content="Salvar e minimizar" Click="MinimizeClick" Margin="0,4,0,0" FontSize="12"/></StackPanel>
    <StackPanel><Button x:Name="NavDeck" Content="▦   Seu teclado" Click="DeckClick"/><Button Content="☀   Iluminação" Click="LedClick"/><Button Content="⇣   Gravar no teclado" Click="HardwareClick"/><Button Content="?   Como funciona" Click="HelpClick"/><Border Background="#1B2C37" CornerRadius="9" Padding="12" Margin="0,24,8,0"><StackPanel><TextBlock Text="Mais funções em cada tecla" Foreground="#68DFC3" FontWeight="SemiBold"/><TextBlock Text="Crie camadas para áudio, trabalho, chamadas e atalhos." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Width="205"><TextBlock x:Name="ConnectionText" Text="Verificando conexão…" Foreground="#68DFC3" HorizontalAlignment="Right"/><TextBlock x:Name="ActiveText" Text="Em uso: Principal" Foreground="#93A3B8" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel><StackPanel><TextBlock x:Name="PageTitle" Text="Seu teclado, do seu jeito" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Escolha uma camada, clique em uma tecla e defina sua ação." Style="{StaticResource Caption}" Margin="0,7,0,0"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Background="#192A35" CornerRadius="9" Padding="14,10" Margin="0,0,0,18"><DockPanel><Button x:Name="BridgeButton" DockPanel.Dock="Right" Content="Ativar camadas" Style="{StaticResource Primary}" Click="BridgeClick" Padding="12,7" Margin="12,0,0,0"/><StackPanel><TextBlock x:Name="BridgeTitle" Text="Prepare o teclado uma única vez" FontWeight="SemiBold" Foreground="#9CE9D6"/><TextBlock x:Name="BridgeText" Text="O MiniDeck precisa ficar aberto para executar camadas e controles de áudio." FontSize="12" Foreground="#AEC0CF" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
   <Grid Grid.Row="2">
    <Grid x:Name="DeckView">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
     <ScrollViewer><StackPanel>
      <DockPanel><TextBlock Text="SUAS CAMADAS" Foreground="#93A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="+ Nova" Click="AddLayerClick" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="11,6" Margin="8,0,0,6"/><Button Content="+ Sons" Name="AddSoundsLayerButton" Click="AddSoundsLayerClick" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="11,6" Margin="8,0,0,6" ToolTip="Cria uma camada para sons e configura o knob para o volume deles."/></DockPanel>
      <WrapPanel x:Name="LayerPanel" Margin="0,10,0,8"/>
      <WrapPanel Margin="0,0,0,6"><Button Content="Renomear" Click="RenameLayerClick" Padding="9,5" FontSize="11"/><Button Content="Duplicar" Click="DuplicateLayerClick" Padding="9,5" FontSize="11"/><Button Content="Cor do painel" Click="LayerColorClick" Padding="9,5" FontSize="11" ToolTip="Cor que identifica esta camada na tela; não altera o LED do teclado."/><Button Content="Excluir camada" Click="DeleteLayerClick" Padding="9,5" FontSize="11"/></WrapPanel>
      <Border Background="#151F2E" CornerRadius="16" BorderBrush="#2A394E" BorderThickness="1" Padding="19"><StackPanel><DockPanel Margin="0,0,0,16"><TextBlock Text="MINI KEYBOARD" FontSize="11" FontWeight="SemiBold" Foreground="#93A3B8"/><TextBlock x:Name="LayoutCaption" Text="6 teclas · 1 knob" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="#93A3B8"/></DockPanel><UniformGrid x:Name="KeyGrid" Columns="3"/><StackPanel x:Name="KnobPanel" Margin="0,14,0,0"/><TextBlock Text="Clique em uma tecla para configurar. Ao apertar no teclado, a tecla acende aqui." Style="{StaticResource Caption}" Margin="0,13,0,0"/></StackPanel></Border>
      <Expander Header="Ajustar layout e gerenciar perfil" Foreground="#B3C0D2" Margin="0,20,0,0"><StackPanel Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Teclas físicas"/><ComboBox x:Name="KeyCountBox" SelectionChanged="LayoutChanged"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Botões giratórios"/><ComboBox x:Name="KnobCountBox" SelectionChanged="LayoutChanged"/></StackPanel></Grid><WrapPanel><Button Content="Exportar perfil" Click="ExportClick" FontSize="12"/><Button Content="Importar perfil" Click="ImportClick" FontSize="12"/></WrapPanel><TextBlock Text="O perfil inclui todas as camadas. Exportar não lê a memória do teclado." Style="{StaticResource Caption}"/></StackPanel></Expander>
     </StackPanel></ScrollViewer>
     <Border Grid.Column="2" Background="#151F2E" CornerRadius="14" Padding="21" BorderBrush="#2A394E" BorderThickness="1"><ScrollViewer><StackPanel>
      <TextBlock Text="CONFIGURAR AÇÃO" Foreground="#68DFC3" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="EditorTitle" Text="Tecla 1" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,0"/><TextBlock x:Name="EditorLayer" Style="{StaticResource Caption}"/>
      <CheckBox x:Name="LayerHotkeysBox" Content="Atalhos exclusivos por camada" Foreground="#68DFC3" Margin="0,0,0,8" Checked="LayerHotkeysChanged" Unchecked="LayerHotkeysChanged" ToolTip="Enquanto ativo, reserva os F13–F24 físicos de todos os teclados para o MiniDeck. Teclas sem ação enviam o atalho da camada atual. Desmarque para o comportamento compartilhado anterior."/>
      <local:ActionEditor x:Name="Editor"/>
      <Button Content="Salvar ação" Style="{StaticResource Primary}" Click="SaveActionClick" HorizontalContentAlignment="Center" Margin="0,4,0,8"/><Button Content="Testar ação em 3 segundos" Click="TestActionClick" HorizontalContentAlignment="Center" Margin="0,0,0,8"/><TextBlock Text="Salve antes de trocar de tecla. No teste, você tem 3 segundos para colocar o aplicativo de destino em primeiro plano." Style="{StaticResource Caption}" FontSize="11"/>
     </StackPanel></ScrollViewer></Border>
    </Grid>
    <ScrollViewer x:Name="LedView" Visibility="Collapsed"><StackPanel MaxWidth="750" HorizontalAlignment="Left"><TextBlock Text="Os três modos disponíveis neste protocolo" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="O protocolo oferece os modos 0, 1 e 2. Os nomes originais não descrevem os efeitos. A presença de LEDs e o efeito de cada modo dependem da versão do teclado." Style="{StaticResource Caption}" FontSize="14" Margin="0,12,0,22"/><TextBlock Text="Camada na memória do teclado"/><ComboBox x:Name="LedLayer"/><TextBlock Text="Modo de iluminação"/><ComboBox x:Name="LedMode"/><TextBlock x:Name="LastLedMode" Style="{StaticResource Caption}"/><Button x:Name="ApplyLedButton" Content="Gravar modo de LED" Click="ApplyLedClick" Style="{StaticResource Primary}"/><Border Background="#192A35" Padding="18" CornerRadius="10" Margin="0,20,0,0"><TextBlock Text="O software original não contém comandos para escolher cor RGB, brilho, velocidade ou luz por tecla. Por isso, esses ajustes não aparecem aqui. Alterar o LED grava a configuração de iluminação na memória do teclado." Foreground="#AEC0CF"/></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="HardwareView" Visibility="Collapsed"><StackPanel MaxWidth="750" HorizontalAlignment="Left"><TextBlock Text="Uma ação que funciona sem o MiniDeck aberto" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Grave atalhos, sequências de até 5 teclas, mídia e mouse diretamente no teclado. Volume por aplicativo, microfone e camadas do MiniDeck precisam do aplicativo em segundo plano." Style="{StaticResource Caption}" FontSize="14" Margin="0,12,0,20"/>
     <TextBlock Text="Entrada física"/><ComboBox x:Name="HardwareSlot"/><TextBlock Text="Camada na memória do teclado"/><ComboBox x:Name="HardwareLayer"/><TextBlock Text="Tipo de comando"/><ComboBox x:Name="HardwareKind" SelectionChanged="HardwareKindChanged"/>
     <StackPanel x:Name="HardwareTextPanel"><TextBlock Text="Atalho ou sequência (separe os passos com ponto e vírgula)"/><TextBox x:Name="HardwareValue" Text="Ctrl+C"/><TextBlock Text="Exemplos: Ctrl+C  ·  Ctrl+A; Ctrl+C  ·  Alt+Tab  ·  F5. O layout PT-BR é definido no Windows." Style="{StaticResource Caption}"/></StackPanel>
     <StackPanel x:Name="HardwareChoicePanel" Visibility="Collapsed"><TextBlock Text="Comando"/><ComboBox x:Name="HardwareChoice"/></StackPanel>
     <Button x:Name="ApplyHardwareButton" Content="Revisar e gravar esta entrada" Click="ApplyHardwareClick" Style="{StaticResource Primary}"/><TextBlock Text="A gravação substitui o comando dessa entrada. Não foi encontrado um comando para ler ou recuperar a configuração anterior. O modo de camadas será pausado para evitar ações diferentes do painel." Style="{StaticResource Caption}"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="HelpView" Visibility="Collapsed"><StackPanel x:Name="HelpContent" MaxWidth="760" HorizontalAlignment="Left"/></ScrollViewer>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#28354A" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,12,0,0"><TextBlock x:Name="StatusText" Text="Pronto. Nenhuma configuração do teclado foi alterada." Foreground="#93A3B8" FontSize="12"/></Border>
  </Grid>
 </Grid>
</Window>
